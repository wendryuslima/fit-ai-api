generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  workoutPlans WorkutPlan[]
}

model WorkutPlan {
  id          String       @id @default(uuid())
  name        String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workoutDays WorkoutDay[]
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkoutDay {
  id            String           @id @default(uuid())
  name          String
  workoutPlanId String
  workouPlan    WorkutPlan       @relation(fields: [workoutPlanId], references: [id])
  isRest        Boolean          @default(false)
  weekDay       WeekDay
  exercices     WorkouExervice[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model WorkouExervice {
  id                String     @id @default(uuid())
  name              String
  order             Int
  workoutDayId      String
  workoutDay        WorkoutDay @relation(fields: [workoutDayId], references: [id])
  sets              Int
  reps              Int
  restTimeInSeconds Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}
